#workspace-config: { shape: page; style.opacity: 0 };


  workspace-config: {
#  grid-rows: 1
#  grid-columns: 2
  branches.*."0.8.0".class: active
  branches.*."0.9.0".class: inactive
  *.grid-columns: 1;
  branches: {

    dev:{"0.8.0"; "0.9.0"}
    assets: {"0.8.0"; "0.9.0"}
    documents: {"0.8.0"; "0.9.0"}
    initial: {"0.8.0"; "0.9.0"}
    pristine: {"0.8.0"; "0.9.0"}
    sandbox: {"0.8.0"; "0.9.0"}
    seed: {"0.8.0"; "0.9.0"}
    tests: {"0.8.0"; "0.9.0"}
    tools: {"0.8.0"; "0.9.0"}
    pre-release_splash
  }



workspace: {
  "develop"
  "assets"
  "documentation"
  "initial"
  "pristine"
  "sandbox"
  "seed"
  "tests"
  "tools"
}

workspace."develop" -- branches."dev": "0.8.0-dev"
workspace."assets" -- branches."assets": "0.8.0-assets"
workspace."documentation" -- branches."documents": "0.8.0-documents"
workspace."initial" -- branches."initial": "0.8.0-initial"
workspace."pristine" -- branches."pristine": "0.8.0-pristine"
workspace."sandbox" -- branches."sandbox": "0.8.0-sandbox"
workspace."seed" -- branches."seed": "0.8.0-seed"
workspace."tests" -- branches."tests": "0.8.0-tests"
workspace."tools" -- branches."tools": "0.8.0-tools"
workspace."splash" -- branches."pre-release_splash"


}
