strict digraph "oa:resources" {
  compound=true;
  concentrate=true;
  newrank=true;
  page=A4;
  nodesep=0.5;
  ranksep=1.5;
  rankdir=TB;
  fontname="Fira Code";
  node [shape=box, style="rounded",fontname="Fira Code"];
  edge [color="#333333"];

subgraph cluster_domains {
  label="Domains";
  labelloc=b;
  style=dashed;

 subgraph "cluster_resource_semantics" {
      labelloc=b;
      label="Resource Domain Contexts"
      fillcolor="#F1F8E9";
          node [shape=record];
            "«oa»" [label="{Prefix | oa} | {Namespace | oa.local/ns/orchestration-architect} | {Fragment | #oa}}"];
            "«oa-resources»" [label="{Prefix | oa-resources} | {Namespace | semantics.oa.local/ns/orchestration-architect} | {Fragment | #oa:resources}"];
            "«oa-semantics»" [label="{Prefix | oa-semantics} | {Namespace | semantics.oa.local/ns/orchestration-architect} | {Fragment | #oa:semantics}"];
            "«oa-collections»" [label="{Prefix | oa-collections} | {Namespace | semantics.oa.local/ns/orchestration-architect} | {Fragment | #oa:collections}"];
            "«oa»" -> {
              "«oa-resources»" -> "«oa-collections»" [label="resource\ncontext"];
              "«oa-semantics»" -> "«oa-collections»" [label="semantic\ncoontext"];
            } [label="namespace\ncontext"];

              
}
subgraph "cluster_resource" {


      // "«oa:namespace»" [label="«oa-collections»"];
      // "«oa:domain»" -> "«oa:namespace»";
      "«collection»" -> {
        "«role»";
        "«playbook»";
        "«template»";        
      };

    "«template»" -> {
      "«fragments»";
      "«skeleton»";
    }
  }
  subgraph "cluster_filesystem_domain" { 
      label="File System Domain"
      labelloc=t
    "«oa:collections»\ncollections/" -> "«namespace»\norchestration_architect/" -> "«collection»\nMeta/" -> {
      "roles/";
      "playbooks/";
      "templates/";
      "vars/";
      "defaults/";
    }
    }
  subgraph "cluster_specification_domain" {
    

  }
  subgraph "cluster_subsystem" {  
    labelloc=t;
    label="Orchestration Architect // Collections // The 'Meta' Subsystem\norchestration-architect.meta.*"
    fillcolor="#E8F5E9";
    style="filled,rounded";
    node [shape=record];    
    "«oa:collections»" -> "«namespace»\norchestration_architect" -> 
    "«collection»\norchestration_architect.meta" -> "collections/Meta/Roles" ;
    "collections/Meta/Roles" -> subgraph "cluster_roles_in_meta" {
    label="Meta Subsystem Collection - Roles";
          "«role»\nmeta_role";
          "«role»\nmeta_template";
          "«role»\nmeta_orchestrator";
          "«role»\nmeta_playbook";
        };
        
    }
  } 
}
