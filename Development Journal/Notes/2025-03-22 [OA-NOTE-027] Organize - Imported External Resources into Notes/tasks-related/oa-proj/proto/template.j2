    <section>
        <h1>Documentation :: Orchestration Architect</h1>
        <p>This document provides an overview of the Orchestration Architect Schema, including its entities, relationships, and namespaces.</p>

        <section id="entities">
            <h2>Entities</h2>
            <p>The following entities are defined within the OA Schema:</p>
            <ul>
                {% for entity in entities %}
                <li><strong>{{ entity.category }}</strong>: {{ entity.description }}
                    <ul>
                    {% for relationship in entity.relationships %}
                        <li>{{ relationship.type }} &rarr; {{ relationship.target }}</li>
                    {% endfor %}
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </section>

