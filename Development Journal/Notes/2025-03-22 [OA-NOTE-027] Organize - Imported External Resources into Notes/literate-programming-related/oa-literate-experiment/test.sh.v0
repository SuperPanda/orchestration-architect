FUNCTION_START_PATTERN="^\w+\(\)\{"
FUNCTION_END_PATTERN="^}$"
extract_region(){
    local start="$1"
    local end="$2"
    head -n+$((end)) | tail -n+$((start))
}
extract_file_region(){
    local file="$1"
    local start="$2"
    local end="$3"
    #head -n`echo "+"$(($end))` "$file" | tail -n`echo "+"$(($start))`
    head -n+$((end)) "$file" | tail -n+$((start))
}


find_line_matches(){
  local pattern="$1"
  grep -E $pattern --line-number | cut -d: -f1
}

find_next_match_offset(){
  local pattern="$1"
  local cursor_start="${2:-1}"
  tail -n+$((cursor_start)) |  grep -m 1 -E $pattern --line-number| cut -d: -f1
}

find_region_boundary(){ 
  local start_boundary_pattern="$1"
  local end_boundary_pattern="$2"
  state=`cat`
  start_positions_matches="$( cat <<< $state | find_line_matches $start_boundary_pattern)"
  #echo -e "Region start positions:\n$start_positions_matches"
  for start_position in $start_positions_matches; do #$(find_line_matches $start_boundary_pattern); do
    #echo "Start Position $start_position"
    offset=$( cat <<< $state  | find_next_match_offset $end_boundary_pattern $start_position)
    #echo "Offset $offset"
    end_position=$((start_position+offset))
    #echo "End position $end_position"
    cat <<< $state | extract_region $start_position $end_position
  done
}
find_file_region_boundary(){ 
  local file="$1"
  local start_boundary_pattern="$2"
  local end_boundary_pattern="$3"
  start_positions_matches="$(cat $file | find_line_matches $start_boundary_pattern)"
    offset=$(cat $file | find_next_match_offset $end_boundary_pattern $start_position)
    end_position=$((start_position+offset-1))
    cat | extract_region $start_position $end_position
  done
}


#cat ./test.sh | extract_region 2 4
echo "Find Line Matches"
cat ./test.sh | find_line_matches $FUNCTION_START_PATTERN
echo "Find Next Offset"
cat ./test.sh | find_next_match_offset $FUNCTION_END_PATTERN
echo "Find File Regions"
#find_file_region_boundary $0 $FUNCTION_START_PATTERN $FUNCTION_END_PATTERN
cat ./test.sh | find_region_boundary $FUNCTION_START_PATTERN $FUNCTION_END_PATTERN




