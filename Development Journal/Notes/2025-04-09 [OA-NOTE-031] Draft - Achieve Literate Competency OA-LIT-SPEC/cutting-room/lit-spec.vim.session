let SessionLoad = 1
let s:so_save = &g:so | let s:siso_save = &g:siso | setg so=0 siso=0 | setl so=-1 siso=-1
let v:this_session=expand("<sfile>:p")
silent only
silent tabonly
cd ~/repos/orchestration-architect/documentation/Development\ Journal/Notes/2025-04-09\ \[OA-NOTE-031]\ Draft\ -\ Achieve\ Literate\ Competency\ OA-LIT-SPEC
if expand('%') == '' && !&modified && line('$') <= 1 && getline(1) == ''
  let s:wipebuf = bufnr('%')
endif
let s:shortmess_save = &shortmess
if &shortmess =~ 'A'
  set shortmess=aoOA
else
  set shortmess=aoO
endif
badd +17 LIT-SPEC.README.md
badd +2 Literate\ Specifications/SPEC-000\ Literate\ Specification.md
badd +54 lit-spec.d2
badd +0 lit-spec-notes.md
argglobal
%argdel
$argadd LIT-SPEC.README.md
edit lit-spec-notes.md
let s:save_splitbelow = &splitbelow
let s:save_splitright = &splitright
set splitbelow splitright
wincmd _ | wincmd |
vsplit
wincmd _ | wincmd |
vsplit
2wincmd h
wincmd w
wincmd w
let &splitbelow = s:save_splitbelow
let &splitright = s:save_splitright
wincmd t
let s:save_winminheight = &winminheight
let s:save_winminwidth = &winminwidth
set winminheight=0
set winheight=1
set winminwidth=0
set winwidth=1
exe 'vert 1resize ' . ((&columns * 53 + 68) / 137)
exe 'vert 2resize ' . ((&columns * 52 + 68) / 137)
exe 'vert 3resize ' . ((&columns * 30 + 68) / 137)
argglobal
balt Literate\ Specifications/SPEC-000\ Literate\ Specification.md
setlocal foldmethod=manual
setlocal foldexpr=0
setlocal foldmarker={{{,}}}
setlocal foldignore=#
setlocal foldlevel=99
setlocal foldminlines=1
setlocal foldnestmax=20
setlocal foldenable
silent! normal! zE
let &fdl = &fdl
let s:l = 8 - ((7 * winheight(0) + 32) / 64)
if s:l < 1 | let s:l = 1 | endif
keepjumps exe s:l
normal! zt
keepjumps 8
normal! 026|
wincmd w
argglobal
if bufexists(fnamemodify("lit-spec.d2", ":p")) | buffer lit-spec.d2 | else | edit lit-spec.d2 | endif
if &buftype ==# 'terminal'
  silent file lit-spec.d2
endif
balt Literate\ Specifications/SPEC-000\ Literate\ Specification.md
setlocal foldmethod=manual
setlocal foldexpr=0
setlocal foldmarker={{{,}}}
setlocal foldignore=#
setlocal foldlevel=99
setlocal foldminlines=1
setlocal foldnestmax=20
setlocal foldenable
silent! normal! zE
let &fdl = &fdl
let s:l = 55 - ((0 * winheight(0) + 32) / 65)
if s:l < 1 | let s:l = 1 | endif
keepjumps exe s:l
normal! zt
keepjumps 55
normal! 050|
wincmd w
argglobal
enew
balt LIT-SPEC.README.md
setlocal foldmethod=manual
setlocal foldexpr=0
setlocal foldmarker={{{,}}}
setlocal foldignore=#
setlocal foldlevel=99
setlocal foldminlines=1
setlocal foldnestmax=20
setlocal foldenable
wincmd w
exe 'vert 1resize ' . ((&columns * 53 + 68) / 137)
exe 'vert 2resize ' . ((&columns * 52 + 68) / 137)
exe 'vert 3resize ' . ((&columns * 30 + 68) / 137)
tabnext 1
if exists('s:wipebuf') && len(win_findbuf(s:wipebuf)) == 0 && getbufvar(s:wipebuf, '&buftype') isnot# 'terminal'
  silent exe 'bwipe ' . s:wipebuf
endif
unlet! s:wipebuf
set winheight=1 winwidth=20
let &shortmess = s:shortmess_save
let &winminheight = s:save_winminheight
let &winminwidth = s:save_winminwidth
let s:sx = expand("<sfile>:p:r")."x.vim"
if filereadable(s:sx)
  exe "source " . fnameescape(s:sx)
endif
let &g:so = s:so_save | let &g:siso = s:siso_save
set hlsearch
nohlsearch
doautoall SessionLoadPost
unlet SessionLoad
